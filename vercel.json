{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/gotecx-pos run build",
  "outputDirectory": "artifacts/gotecx-pos/dist/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
